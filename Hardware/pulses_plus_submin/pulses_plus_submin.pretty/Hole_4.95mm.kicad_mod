(footprint "Hole_4.95mm"
	(descr "Panel hole for the Taiway 200-MDP3 sub-miniature toggle bushing, 4.95 mm non-plated (10-48 UNS bushing, o4.80 thread). Origin at the hole centre. Previously supplied by an out-of-tree 'Panel' library; vendored here so the panel project opens on any machine. Pad layers are *.Cu plus 'Rescue', matching the placed instances byte-for-byte. 'Rescue' is a stale layer name inherited from the original out-of-tree Panel library and is NOT in the panel's layer table, so KiCad ignores it and the hole gets no mask aperture. Do not 'correct' it to *.Mask: that would open soldermask around every hole, changing the already-fabbed gerbers, and would raise 27 lib_footprint_mismatch DRC errors.")
	(version 20260206)
	(generator "extracted-from-board")
	(layer "F.Cu")
	(attr exclude_from_pos_files exclude_from_bom allow_missing_courtyard)
	(property "Reference" ""
		(at 0 0 0)
		(layer "F.SilkS")
		(hide yes)
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
		)
	)
	(property "Value" "SW"
		(at 0 0 0)
		(layer "F.Fab")
		(hide yes)
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
		)
	)
	(property "Datasheet" ""
		(at 0 0 0)
		(layer "F.Fab")
		(hide yes)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
	)
	(property "Description" ""
		(at 0 0 0)
		(layer "F.Fab")
		(hide yes)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
	)
	(duplicate_pad_numbers_are_jumpers no)
	(pad "" np_thru_hole circle
		(at 0 0)
		(size 4.95 4.95)
		(drill 4.95)
		(layers "*.Cu" "Rescue")
	)
	(embedded_fonts no)
)
